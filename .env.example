# ============================================
# FuelTrack Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database
DefaultConnection=Server=localhost;Database=FuelTrack;User Id=sa;Password=<STRONG_DB_PASSWORD>;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT (min 32 chars, must contain digits + special characters)
JwtSettings__Key=<REPLACE_WITH_SECURE_KEY_MIN_32_CHARS>
JwtSettings__Issuer=FuelTrack.API
JwtSettings__Audience=FuelTrack.Clients

# Admin
AdminSettings__DefaultPassword=<REPLACE_WITH_STRONG_PASSWORD>

# Data Encryption (must be set in production)
DataEncryption__Key=<REPLACE_WITH_32_CHAR_BASE64_KEY>

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:5001;http://+:5000
