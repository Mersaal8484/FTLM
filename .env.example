# Copy to .env and replace every placeholder before starting Compose.
SQL_SA_PASSWORD=CHANGE_ME_SQL_PASSWORD
JWT_KEY=CHANGE_ME_JWT_KEY_AT_LEAST_32_CHARS_1!
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_1!
# Base64-encoded 32-byte key; keep it stable to decrypt existing data.
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Local HTTP development. Production requires HTTPS and a real CORS origin.
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
JWT_ISSUER=FuelTrack.API
JWT_AUDIENCE=FuelTrack.Clients
