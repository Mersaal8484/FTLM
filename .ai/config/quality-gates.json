{
  "qualityGates": {
    "newFeature": {
      "build": {
        "required": true,
        "command": "dotnet build",
        "description": "Solution compiles without errors"
      },
      "tests": {
        "required": true,
        "command": "dotnet test",
        "description": "All unit and integration tests pass"
      },
      "migration": {
        "required": true,
        "validation": "ef migrations script",
        "description": "EF Core migration generates valid SQL script"
      },
      "swagger": {
        "required": true,
        "check": "swagger.json updated",
        "description": "API documentation reflects new endpoints"
      },
      "documentation": {
        "required": true,
        "check": "README and API docs updated",
        "description": "Project documentation is current"
      },
      "permissions": {
        "required": true,
        "check": "PermissionGate attributes present",
        "description": "New endpoints have proper authorization"
      },
      "performance": {
        "required": true,
        "check": "No N+1 queries, AsNoTracking used",
        "description": "Query patterns follow performance best practices"
      },
      "security": {
        "required": true,
        "check": "Input validation, no secrets in code",
        "description": "Input is validated and no secrets are hardcoded"
      }
    },
    "bugFix": {
      "build": {
        "required": true,
        "command": "dotnet build",
        "description": "Solution compiles without errors"
      },
      "tests": {
        "required": true,
        "command": "dotnet test",
        "description": "All existing tests still pass"
      },
      "regression": {
        "required": true,
        "check": "Regression test added",
        "description": "Test covering the bug scenario is added"
      },
      "documentation": {
        "required": false,
        "check": "README and API docs updated",
        "description": "Documentation updated if behavior changed"
      }
    },
    "refactoring": {
      "build": {
        "required": true,
        "command": "dotnet build",
        "description": "Solution compiles without errors"
      },
      "tests": {
        "required": true,
        "command": "dotnet test",
        "description": "All existing tests still pass"
      },
      "architecture": {
        "required": true,
        "check": "Clean Architecture compliance",
        "description": "Code respects layer boundaries (Domain -> Application -> Infrastructure -> API)"
      },
      "documentation": {
        "required": true,
        "check": "README and API docs updated",
        "description": "Architecture decisions documented"
      }
    },
    "databaseChange": {
      "build": {
        "required": true,
        "command": "dotnet build",
        "description": "Solution compiles without errors"
      },
      "tests": {
        "required": true,
        "command": "dotnet test",
        "description": "All tests pass"
      },
      "migration": {
        "required": true,
        "validation": "ef migrations script",
        "description": "Migration is reversible and generates valid SQL"
      },
      "rollback": {
        "required": true,
        "check": "Rollback path defined",
        "description": "Down migration or manual rollback is documented"
      },
      "performance": {
        "required": true,
        "check": "Indexes evaluated, no missing FK indexes",
        "description": "Schema changes maintain query performance"
      }
    },
    "securityChange": {
      "build": {
        "required": true,
        "command": "dotnet build",
        "description": "Solution compiles without errors"
      },
      "tests": {
        "required": true,
        "command": "dotnet test",
        "description": "All tests pass"
      },
      "audit": {
        "required": true,
        "check": "Security audit completed",
        "description": "Changes reviewed against OWASP Top 10"
      },
      "secrets": {
        "required": true,
        "check": "No secrets in code or config",
        "description": "All secrets are in User Secrets or env vars"
      },
      "auth": {
        "required": true,
        "check": "Authorization attributes verified",
        "description": "Endpoints have correct [Authorize] and role requirements"
      }
    }
  },
  "severityLevels": {
    "critical": {
      "description": "Must be fixed before merge",
      "examples": ["Build failure", "Security vulnerability", "Data loss risk", "Authentication bypass"],
      "action": "Block merge, fix immediately"
    },
    "high": {
      "description": "Should be fixed before merge",
      "examples": ["Test failure", "Performance regression", "Missing validation", "N+1 query"],
      "action": "Fix before merge, discuss with team if deferring"
    },
    "medium": {
      "description": "Can be fixed in follow-up",
      "examples": ["Code smell", "Missing documentation", "Inconsistent naming", "Minor refactoring"],
      "action": "Create follow-up issue, merge with fix planned"
    },
    "low": {
      "description": "Optional improvement",
      "examples": ["Style preferences", "Nice-to-have optimizations", "Cosmetic changes"],
      "action": "Note in PR, fix opportunistically"
    }
  },
  "ciPipeline": {
    "steps": [
      "dotnet restore",
      "dotnet build --no-restore",
      "dotnet test --no-build --verbosity normal",
      "ef migrations script --idempotent --output ./migrations/current.sql"
    ],
    "thresholds": {
      "testCoverageMinimum": 80,
      "maxWarnings": 0,
      "maxErrors": 0,
      "buildTimeoutMinutes": 15
    }
  }
}
