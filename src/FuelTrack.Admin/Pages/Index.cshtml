@page
@model FuelTrack.Admin.Pages.IndexModel
<section><h1>المستأجرون</h1><p>يُسجّل المستأجر بحالة قيد التجهيز؛ لا يُفعّل وصوله حتى يجهز مخططه.</p><p class="error">@Model.Error</p>
<form method="post"><label>اسم المستأجر <input asp-for="Name" maxlength="200" required /></label><label>النطاق الفرعي <input asp-for="Host" maxlength="253" placeholder="client.example.com" required /></label><button>إضافة</button></form></section>
<section>@if (!Model.CanProvision) { <p>تجهيز قواعد المستأجرين غير متاح حتى يُضبط مفتاح التشفير.</p> }<table><thead><tr><th>الاسم</th><th>النطاق</th><th>الحالة</th><th>التجهيز</th></tr></thead><tbody>@foreach (var tenant in Model.Tenants) { <tr><td>@tenant.Name</td><td>@tenant.Host</td><td>@tenant.Status</td><td>@if (Model.CanProvision && tenant.Status == FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Provisioning) { <form method="post" asp-page-handler="Provision"><input type="hidden" name="id" value="@tenant.Id" /><label>بريد المدير <input type="email" name="adminEmail" maxlength="256" required /></label><label>كلمة مرور المدير <input type="password" name="adminPassword" minlength="12" maxlength="128" autocomplete="new-password" required /></label><button>تجهيز قاعدة البيانات</button></form> }</td></tr> }</tbody></table></section>
