@page
@model FuelTrack.Admin.Pages.IndexModel
<div class="page-heading">
    <div><span class="eyebrow">إدارة المنصة / المستأجرون</span><h1>المستأجرون</h1><p>إدارة حسابات المستأجرين وتجهيز قواعد بياناتهم من مكان واحد.</p></div>
    <div class="heading-count"><span>إجمالي المستأجرين</span><strong>@Model.TotalTenants</strong></div>
</div>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-error" role="alert">@Model.Error</div> }
@if (!string.IsNullOrEmpty(Model.Success)) { <div class="alert alert-success" role="status">@Model.Success</div> }
<div class="stats-grid" aria-label="ملخص المستأجرين">
    <div class="stat-card"><span>إجمالي المستأجرين</span><strong>@Model.TotalTenants</strong></div>
    <div class="stat-card"><span>قيد التجهيز</span><strong>@Model.ProvisioningCount</strong></div>
    <div class="stat-card"><span>المستأجرون النشطون</span><strong>@Model.ActiveCount</strong></div>
</div>
<section class="card">
    <div class="card-heading"><div><h2>إضافة مستأجر</h2><p>أدخل بيانات المستأجر الأساسية للبدء بتجهيزه.</p></div><span class="card-icon" aria-hidden="true">＋</span></div>
    <form method="post" class="form-grid tenant-create">
        <label>اسم المستأجر <input asp-for="Name" maxlength="200" placeholder="مثال: شركة الأفق" required /></label>
        <label>النطاق الفرعي <input asp-for="Host" maxlength="253" placeholder="client.example.com" dir="ltr" required /></label>
        <button type="submit">إضافة مستأجر <span aria-hidden="true">＋</span></button>
    </form>
    <p class="form-note">يُسجّل المستأجر بحالة قيد التجهيز؛ لا يُفعّل وصوله حتى يجهز مخططه.</p>
</section>
<section class="card list-card">
    <div class="card-heading"><div><h2>قائمة المستأجرين</h2><p>تابع حالة التسجيل وتجهيز قاعدة البيانات.</p></div><span class="count-badge">@Model.ResultCount نتيجة</span></div>
    <form method="get" class="search-form" role="search">
        <label for="tenant-search" class="visually-hidden">البحث باسم المستأجر أو نطاقه</label>
        <input id="tenant-search" name="q" value="@Model.Q" maxlength="100" placeholder="ابحث باسم المستأجر أو النطاق" />
        <button type="submit" class="button-secondary">بحث</button>
        @if (Model.Q is not null) { <a asp-page="/Index" class="clear-link">مسح البحث</a> }
    </form>
    @if (!Model.CanProvision) { <div class="alert alert-info">تجهيز قواعد المستأجرين غير متاح حتى يُضبط مفتاح التشفير.</div> }
    @if (Model.Tenants.Count == 0) { <div class="empty-state">@(Model.Q is null ? "لا يوجد مستأجرون بعد. أضف أول مستأجر للبدء." : "لا توجد نتائج مطابقة للبحث.")</div> }
    else {
    <div class="table-wrap"><table><thead><tr><th>المستأجر</th><th>النطاق</th><th>الحالة</th><th>التجهيز</th></tr></thead><tbody>
    @foreach (var tenant in Model.Tenants) {
        <tr><td data-label="المستأجر"><strong>@tenant.Name</strong></td><td data-label="النطاق"><span class="domain" dir="ltr">@tenant.Host</span></td><td data-label="الحالة"><span class="status-badge status-@tenant.Status.ToString().ToLowerInvariant()" title="@tenant.Status">@(tenant.Status switch { FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Provisioning => "قيد التجهيز", FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Active => "نشط", FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Suspended => "موقوف", _ => "مؤرشف" })</span></td><td data-label="التجهيز">
        @if (tenant.IsProvisioned) {
            <span class="provisioned-label">✓ بيانات التجهيز محفوظة</span>
            @if (Model.CanProvision && tenant.Status == FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Provisioning) {
                <form method="post" asp-page-handler="Provision" class="verify-form">
                    <input type="hidden" name="id" value="@tenant.Id" />
                    <button type="submit" class="button-secondary">التحقق من التجهيز</button>
                </form>
            }
        }
        else if (Model.CanProvision && tenant.Status == FuelTrack.Domain.MultiTenancy.PlatformTenantStatus.Provisioning) {
            <details class="provision-details"><summary>تجهيز قاعدة البيانات</summary>
            <form method="post" asp-page-handler="Provision" class="provision-form">
                <input type="hidden" name="id" value="@tenant.Id" />
                <label>بريد المدير <input type="email" name="adminEmail" maxlength="256" placeholder="admin@example.com" dir="ltr" required /></label>
                <label>كلمة مرور المدير <input type="password" name="adminPassword" minlength="12" maxlength="128" autocomplete="new-password" required /></label>
                <small>12 حرفاً على الأقل، تشمل حرفاً كبيراً وصغيراً ورقماً ورمزاً خاصاً.</small>
                <button type="submit">تجهيز قاعدة البيانات</button>
            </form>
            </details>
        }</td></tr>
    }</tbody></table></div> }
    @if (Model.PageCount > 1) {
        <nav class="pagination" aria-label="صفحات المستأجرين">
            @if (Model.PageNumber > 1) { <a asp-page="/Index" asp-route-q="@Model.Q" asp-route-PageNumber="@(Model.PageNumber - 1)">السابق</a> }
            <span>صفحة @Model.PageNumber من @Model.PageCount</span>
            @if (Model.PageNumber < Model.PageCount) { <a asp-page="/Index" asp-route-q="@Model.Q" asp-route-PageNumber="@(Model.PageNumber + 1)">التالي</a> }
        </nav>
    }
</section>
