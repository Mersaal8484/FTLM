@page
@model FuelTrack.Admin.Pages.PlansModel
<div class="page-heading"><div><span class="eyebrow">إدارة المنصة / الباقات</span><h1>الباقات</h1><p>أنشئ الباقات المتاحة لاشتراكات المستأجرين.</p></div></div>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-error" role="alert">@Model.Error</div> }
<section class="card"><div class="card-heading"><div><h2>إضافة باقة</h2><p>حدد اسم الباقة وسعرها والعملة.</p></div><span class="card-icon" aria-hidden="true">＋</span></div>
<form method="post" class="form-grid plan-create"><label>اسم الباقة <input asp-for="Name" maxlength="200" placeholder="مثال: الباقة الأساسية" required /></label><label>السعر <input asp-for="Price" type="number" min="0" step="0.01" required /></label><label>العملة <input asp-for="Currency" minlength="3" maxlength="3" placeholder="USD" dir="ltr" required /></label><button>إضافة باقة <span aria-hidden="true">＋</span></button></form></section>
<section class="card list-card"><div class="card-heading"><div><h2>الباقات المتاحة</h2><p>الباقات المسجلة في المنصة.</p></div></div>
@if (!Model.Plans.Any()) { <div class="empty-state">لا توجد باقات بعد. أضف باقة جديدة للبدء.</div> } else { <div class="table-wrap"><table><thead><tr><th>الباقة</th><th>السعر</th><th>العملة</th></tr></thead><tbody>@foreach (var plan in Model.Plans) { <tr><td><strong>@plan.Name</strong></td><td>@plan.Price</td><td><span class="currency-badge">@plan.Currency</span></td></tr> }</tbody></table></div> }</section>
