{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,8749;Database=FuelTrack;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10;Application Name=FuelTrack;Pooling=true;",
    "Redis": ""
  },
  "ApiUrl": "http://localhost:5000",
  "JwtSettings": {
    "Key": "",
    "Issuer": "FuelTrack.API",
    "Audience": "FuelTrack.Clients",
    "SignalRAudience": "FuelTrack.SignalR",
    "AccessTokenExpirationMinutes": 60,
    "SignalRAccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationDays": 7
  },
  "AdminSettings": {
    "DefaultPassword": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fueltrack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "EnableSwagger": false,
  "DataEncryption": {
    "Key": ""
  },
  "FrontendBaseUrl": "http://localhost:3000",
  "Smtp": {
    "Host": "<REPLACE_WITH_SMTP_HOST>",
    "Port": 587,
    "Username": "<REPLACE_WITH_SMTP_USERNAME>",
    "Password": "<REPLACE_WITH_SMTP_PASSWORD>",
    "From": "<REPLACE_WITH_FROM_EMAIL>",
    "FromName": "FuelTrack",
    "EnableSsl": true
  }
}